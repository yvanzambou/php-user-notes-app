# Vorlage für die lokale Konfiguration:
#   cp .env.example .env
# Danach die Passwörter ändern. Die Datei .env wird nie committet (siehe .gitignore).

# Anwendung: development | production
APP_ENV=development
APP_PORT=8080
APP_TIMEZONE=Europe/Berlin

# Datenbank (MariaDB)
DB_NAME=notes
DB_USER=notes_app
DB_PASS=change-me-app-password
DB_ROOT_PASSWORD=change-me-root-password
